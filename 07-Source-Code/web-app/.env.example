# Default development mode: no Firebase project, Java, account or network required.
VITE_DATA_ADAPTER=mock
VITE_AUTH_ADAPTER=mock
VITE_QR_BASE_URL=http://localhost:5173

# Optional: change VITE_DATA_ADAPTER to firebase-emulator only when intentionally
# testing the local Firebase Emulator Suite. The values below are demo identifiers.
# หรือใช้ `pnpm dev:emulator` ซึ่งโหลดค่าปลอดภัยจาก `.env.emulator` โดยตรง
VITE_FIREBASE_PROJECT_ID=demo-smart-durian
VITE_FIREBASE_API_KEY=demo-api-key-not-a-secret
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=demo-smart-durian.appspot.com
VITE_FIREBASE_STORAGE_READY=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Live Phone Auth only: keep the raw allowlist in an ignored local env file and
# run `npm run prepare:firebase-auth-allowlist`. Only PBKDF2 digests are exposed
# to the browser bundle; never use a VITE_ prefix for raw phone numbers.
FIREBASE_LIVE_AUTH_ALLOWED_PHONE_NUMBERS=+16505550101
VITE_FIREBASE_LIVE_AUTH_ALLOWED_PHONE_HASHES=
VITE_FIREBASE_LIVE_AUTH_ALLOWLIST_SALT=
VITE_FIREBASE_LIVE_AUTH_ALLOWLIST_ITERATIONS=310000
