# Production app template. Copy to an ignored `.env.local` and fill values from
# Firebase Web App settings before running the hosted/production build.
VITE_DATA_ADAPTER=firebase-live
VITE_AUTH_ADAPTER=firebase-live
VITE_QR_BASE_URL=https://durian-smartfarm.web.app
VITE_FIREBASE_PROJECT_ID=durian-smartfarm
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=durian-smartfarm.firebaseapp.com
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_STORAGE_BUCKET=durian-smartfarm.appspot.com
VITE_FIREBASE_STORAGE_READY=false

# Live Phone Auth only: keep the raw allowlist in an ignored local env file and
# run `npm run prepare:firebase-auth-allowlist`. Only PBKDF2 digests are exposed
# to the browser bundle; never use a VITE_ prefix for raw phone numbers.
# Keep real numbers only in an ignored local env file; never commit them.
FIREBASE_LIVE_AUTH_ALLOWED_PHONE_NUMBERS=REPLACE_IN_IGNORED_ENV_ONLY
VITE_FIREBASE_LIVE_AUTH_ALLOWED_PHONE_HASHES=
VITE_FIREBASE_LIVE_AUTH_ALLOWLIST_SALT=
VITE_FIREBASE_LIVE_AUTH_ALLOWLIST_ITERATIONS=310000
