            && annualSnapshotMatches(
              request.resource.data.before,
              get(annualCyclePath(
                organizationId, farmId, request.resource.data.annualCycleId
              )).data
            )
            && annualSnapshotMatches(
              request.resource.data.after,
              getAfter(annualCyclePath(
                organizationId, farmId, request.resource.data.annualCycleId
