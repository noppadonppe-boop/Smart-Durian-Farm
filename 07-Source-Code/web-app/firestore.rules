                && request.resource.data.target.zoneCodes.size() > 0
                && request.resource.data.target.positionIds.size() == 0)
              || (request.resource.data.target.scope == 'TREE_SET'
                && request.resource.data.target.positionIds.size() > 0)
            )
            && request.resource.data.status == 'PLANNED'
            && request.resource.data.version == 1
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update, delete: if false;
        }

        match /annualPlanFinancials/{planItemId} {
          allow read: if canAccessFinancialData(organizationId, farmId);
          allow create: if canAccessFinancialData(organizationId, farmId)
            && validFinancialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.planItemId == planItemId
            && request.resource.data.annualCycleId is string
            && (request.resource.data.plannedDirectCostBaht == null
