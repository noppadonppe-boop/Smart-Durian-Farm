            && request.resource.data.annualCycleId is string
            && existsAfter(annualCyclePath(
              organizationId, farmId, request.resource.data.annualCycleId
            ))
            && getAfter(annualCyclePath(
              organizationId, farmId, request.resource.data.annualCycleId
            )).data.status != 'CLOSED'
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.stage in [
              'FLOWERING', 'EARLY_FRUIT', 'MID_SEASON', 'PRE_SALE', 'HARVESTED'
            ];
          allow update: if canWriteFruit(organizationId, farmId)
            && validCommercialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.cropCycleId == resource.data.cropCycleId
            && request.resource.data.annualCycleId == resource.data.annualCycleId
