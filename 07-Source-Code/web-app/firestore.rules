            )).data.eventType == 'CYCLE_CORRECTED'
            && getAfter(annualCycleAuditPath(
              organizationId, farmId, request.resource.data.auditEventId
            )).data.targetId == correctionId
            && getAfter(annualCycleAuditPath(
