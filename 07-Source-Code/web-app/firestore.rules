            && request.resource.data.valueQuality in ['MEASURED', 'ESTIMATED', 'UNKNOWN']
            && request.resource.data.countingMode in ['MANUAL', 'AI_ASSISTED']
            && request.resource.data.countMethod in ['FULL_COUNT', 'SAMPLE', 'ESTIMATE', 'UNKNOWN']
            && (
