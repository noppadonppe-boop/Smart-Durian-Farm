              || request.resource.data.directUnitCostBaht >= 0)
            && (request.resource.data.directCostBaht == null
              || request.resource.data.directCostBaht >= 0)
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.version == 1
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update, delete: if false;
        }

        match /inventoryBalances/{lotId} {
          allow read: if canReadCommercial(organizationId, farmId);
          allow create, update: if canManageCommercial(organizationId, farmId)
            && validCommercialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.lotId == lotId
            && request.resource.data.balance >= 0
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && ((!exists(/databases/$(database)/documents/durian-smartfarm/root/organizations/$(organizationId)/farms/$(farmId)/inventoryBalances/$(lotId))
                && request.resource.data.version == 1)
              || request.resource.data.version == resource.data.version + 1);
          allow delete: if false;
        }

        match /commercialOperations/{operationId} {
          allow get: if canReadCommercial(organizationId, farmId)
            && (!exists(/databases/$(database)/documents/durian-smartfarm/root/organizations/$(organizationId)/farms/$(farmId)/commercialOperations/$(operationId))
              || resource.data.resultCollection != 'salesFinancials'
              || canAccessFinancialData(organizationId, farmId));
          allow list: if false;
          allow create: if canWriteFarm(organizationId, farmId)
            && validCommercialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.operationId == operationId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.resultCollection in [
              'cropCycles', 'fruitObservations', 'harvestLots',
              'salesLots', 'salesFinancials', 'inventoryMovements'
            ]
            && (request.resource.data.resultCollection != 'salesFinancials'
              || canAccessFinancialData(organizationId, farmId))
            && request.resource.data.resultId is string
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /commercialAuditEvents/{eventId} {
          allow read: if canReadFarm(organizationId, farmId)
            && (isOrganizationOwner(organizationId)
              || (hasFarmRole(organizationId, farmId, ['FARM_MANAGER', 'AUDITOR'])
                && resource.data.dataClass == 'OPERATIONAL'));
          allow create: if canWriteFarm(organizationId, farmId)
            && validCommercialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.dataClass == 'OPERATIONAL'
            && !request.resource.data.keys().hasAny([
              'amountBaht', 'unitPriceBahtPerKg', 'depositBaht', 'receivedBaht',
              'grossAmountBaht', 'outstandingBaht', 'directUnitCostBaht', 'directCostBaht'
            ])
            && request.resource.data.eventId == eventId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.eventType in [
              'CREATED', 'CORRECTED', 'ARCHIVED', 'STOCK_RECORDED'
            ]
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /commercialFinancialAuditEvents/{eventId} {
          allow read: if canAccessFinancialData(organizationId, farmId);
          allow create: if canAccessFinancialData(organizationId, farmId)
            && validFinancialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.eventId == eventId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.eventType in [
              'CREATED', 'CORRECTED', 'ARCHIVED', 'STOCK_RECORDED'
            ]
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /dashboardViews/{roleBucket} {
          allow get: if canReadFarm(organizationId, farmId)
            && (canAccessFinancialData(organizationId, farmId)
              || !resource.data.keys().hasAny(['salesGrossBaht', 'salesOutstandingBaht']))
            && roleBucket in [
              'ORG_OWNER', 'FARM_MANAGER', 'AGRONOMIST',
              'WORKER', 'SALES_INVENTORY', 'VIEWER'
            ]
            && (
              (isOrganizationOwner(organizationId) && roleBucket == 'ORG_OWNER')
              || roleBucket == currentFarmRole(organizationId, farmId)
            );
          allow list, create, update, delete: if false;
        }

        match /financialDashboardViews/{viewId} {
          allow get: if viewId == 'summary'
            && canAccessFinancialData(organizationId, farmId);
          allow list, create, update, delete: if false;
        }

        match /managementLaborCosts/{costId} {
          allow read: if canAccessFinancialData(organizationId, farmId);
          allow create: if canAccessFinancialData(organizationId, farmId)
            && validFinancialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.laborCostId == costId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /managementOperatingExpenses/{expenseId} {
          allow read: if canAccessFinancialData(organizationId, farmId);
          allow create: if canAccessFinancialData(organizationId, farmId)
            && validFinancialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.expenseId == expenseId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /managementFinancialAuditEvents/{eventId} {
          allow read: if canAccessFinancialData(organizationId, farmId);
          allow create: if canAccessFinancialData(organizationId, farmId)
            && validFinancialScope(request.resource.data, organizationId, farmId)
            && request.resource.data.eventId == eventId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /offlineOperations/{operationId} {
          allow read: if canReadFarm(organizationId, farmId);
          allow create: if canWriteFarm(organizationId, farmId)
            && validOperationalScope(request.resource.data, organizationId, farmId)
            && request.resource.data.keys().hasAll([
              'operationId', 'idempotencyKey', 'organizationId', 'farmId',
              'actorUserId', 'capturedRole', 'kind', 'label', 'targetId',
              'payloadFingerprint', 'requiredRoles', 'status', 'attemptCount',
              'createdAtLabel', 'updatedAtLabel', 'exampleData', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'operationId', 'idempotencyKey', 'organizationId', 'farmId',
              'actorUserId', 'capturedRole', 'kind', 'label', 'targetId',
              'payloadFingerprint', 'requiredRoles', 'status', 'attemptCount',
              'resultEventId', 'conflictReason', 'createdAtLabel', 'updatedAtLabel',
              'exampleData', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.operationId == operationId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.capturedRole == currentFarmRole(organizationId, farmId)
            && request.resource.data.kind in ['WORK_REPORT', 'PHOTO_UPLOAD', 'MASTER_UPDATE']
            && request.resource.data.requiredRoles is list
            && currentFarmRole(organizationId, farmId) in request.resource.data.requiredRoles
            && request.resource.data.status == 'PENDING'
            && request.resource.data.attemptCount == 0
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if canReadFarm(organizationId, farmId)
            && validOperationalScope(request.resource.data, organizationId, farmId)
            && request.resource.data.operationId == resource.data.operationId
            && request.resource.data.idempotencyKey == resource.data.idempotencyKey
            && request.resource.data.organizationId == resource.data.organizationId
            && request.resource.data.farmId == resource.data.farmId
            && request.resource.data.actorUserId == resource.data.actorUserId
            && request.resource.data.capturedRole == resource.data.capturedRole
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.targetId == resource.data.targetId
            && request.resource.data.payloadFingerprint == resource.data.payloadFingerprint
            && request.resource.data.requiredRoles == resource.data.requiredRoles
            && request.resource.data.actorUserId == request.auth.uid
            && resource.data.status in ['PENDING', 'SYNCING']
            && request.resource.data.status in ['SYNCED', 'CONFLICT']
            && request.resource.data.attemptCount == resource.data.attemptCount + 1
            && request.resource.data.updatedAt == request.time
            && existsAfter(operationalAuditPath(
              organizationId, farmId,
              request.resource.data.status == 'SYNCED'
                ? request.resource.data.resultEventId
                : 'audit_sync_' + operationId
            ))
            && (
              (request.resource.data.status == 'SYNCED'
                && canWriteFarm(organizationId, farmId)
                && currentFarmRole(organizationId, farmId) in request.resource.data.requiredRoles)
              || (request.resource.data.status == 'CONFLICT'
                && request.resource.data.conflictReason is string)
            );
          allow delete: if false;
        }

        match /masterConflicts/{conflictId} {
          allow read: if canReadFarm(organizationId, farmId);
          allow create, delete: if false;
          allow update: if canReviewOperationalConflict(organizationId, farmId)
            && validOperationalScope(request.resource.data, organizationId, farmId)
            && request.resource.data.conflictId == resource.data.conflictId
            && request.resource.data.entityType == resource.data.entityType
            && request.resource.data.entityId == resource.data.entityId
            && request.resource.data.fieldName == resource.data.fieldName
            && request.resource.data.serverValue == resource.data.serverValue
            && request.resource.data.deviceValue == resource.data.deviceValue
            && resource.data.status == 'OPEN'
            && request.resource.data.status in ['RESOLVED', 'ESCALATED']
            && request.resource.data.resolution in [
              'KEEP_SERVER', 'APPLY_DEVICE_AS_CORRECTION', 'ESCALATE'
            ]
            && request.resource.data.resolutionReason is string
            && request.resource.data.resolutionReason.size() >= 8
            && request.resource.data.resolvedByUserId == request.auth.uid
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.updatedAt == request.time;
        }

          match /photoRecoveries/{recoveryId} {
            allow read: if canReadFarm(organizationId, farmId);
            allow create: if canWriteFarm(organizationId, farmId)
              && request.resource.data.keys().hasAll([
                'recoveryId', 'organizationId', 'farmId', 'workOrderId', 'photoId',
                'phase', 'actorUserId', 'storagePath', 'status', 'failureMode',
                'retryCount', 'lastError', 'updatedAtLabel', 'exampleData',
                'createdAt', 'updatedAt'
              ])
              && request.resource.data.keys().hasOnly([
                'recoveryId', 'organizationId', 'farmId', 'workOrderId', 'photoId',
                'phase', 'actorUserId', 'storagePath', 'status', 'failureMode',
                'retryCount', 'lastError', 'updatedAtLabel', 'exampleData',
                'createdAt', 'updatedAt'
              ])
              && validOperationalScope(request.resource.data, organizationId, farmId)
              && request.resource.data.recoveryId == recoveryId
              && request.resource.data.actorUserId == request.auth.uid
              && request.resource.data.phase in ['INSTRUCTION', 'BEFORE', 'AFTER']
              && request.resource.data.status in ['FAILED', 'ORPHANED']
              && request.resource.data.failureMode == (
                request.resource.data.status == 'FAILED' ? 'PARTIAL_ONCE' : 'ORPHANED_OBJECT'
              )
              && request.resource.data.retryCount == 0
              && request.resource.data.lastError is string
              && request.resource.data.lastError.size() >= 4
              && request.resource.data.lastError.size() <= 500
              && request.resource.data.storagePath == 'organizations/' + organizationId
                + '/farms/' + farmId + '/workEvidence/'
                + request.resource.data.workOrderId + '/' + request.resource.data.photoId
              && exists(/databases/$(database)/documents/durian-smartfarm/root/organizations/$(organizationId)/farms/$(farmId)/workOrders/$(request.resource.data.workOrderId))
              && (
                (request.resource.data.phase == 'INSTRUCTION'
                  && get(/databases/$(database)/documents/durian-smartfarm/root/organizations/$(organizationId)/farms/$(farmId)/workOrders/$(request.resource.data.workOrderId)).data.createdBy == request.auth.uid)
                || (request.resource.data.phase in ['BEFORE', 'AFTER']
                  && get(/databases/$(database)/documents/durian-smartfarm/root/organizations/$(organizationId)/farms/$(farmId)/workOrders/$(request.resource.data.workOrderId)).data.assignedUserId == request.auth.uid)
              )
              && request.resource.data.createdAt == request.time
              && request.resource.data.updatedAt == request.time;
            allow delete: if false;
            allow update: if canWriteFarm(organizationId, farmId)
            && validOperationalScope(request.resource.data, organizationId, farmId)
            && request.resource.data.recoveryId == resource.data.recoveryId
            && request.resource.data.workOrderId == resource.data.workOrderId
              && request.resource.data.photoId == resource.data.photoId
              && request.resource.data.phase == resource.data.phase
              && request.resource.data.actorUserId == resource.data.actorUserId
            && request.resource.data.storagePath == resource.data.storagePath
            && request.resource.data.failureMode == resource.data.failureMode
            && request.resource.data.updatedAt == request.time
            && (
              (resource.data.status in ['FAILED', 'PENDING', 'ORPHANED']
                && request.resource.data.status == 'UPLOADED'
                && request.resource.data.retryCount == resource.data.retryCount + 1
                && hasFarmRole(organizationId, farmId, [
                  'ORG_OWNER', 'FARM_MANAGER', 'AGRONOMIST', 'WORKER'
                ]))
              || (resource.data.status == 'ORPHANED'
                && request.resource.data.status == 'CLEANED'
                && request.resource.data.retryCount == resource.data.retryCount
                && canReviewOperationalConflict(organizationId, farmId))
            );
        }

        match /exportOperations/{exportId} {
          allow read: if canExportOperationalData(organizationId, farmId)
            && (resource.data.actorUserId == request.auth.uid
              || isOrganizationOwner(organizationId)
              || hasFarmRole(organizationId, farmId, ['FARM_MANAGER', 'AUDITOR']));
          allow create: if canExportOperationalData(organizationId, farmId)
            && validOperationalScope(request.resource.data, organizationId, farmId)
            && request.resource.data.exportId == exportId
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.columns == [
              'eventId', 'organizationId', 'farmId', 'actorUserId', 'eventType',
              'targetType', 'targetId', 'reason', 'beforeSummary', 'afterSummary',
              'createdAtLabel'
            ]
            && request.resource.data.rowCount is int
            && request.resource.data.rowCount >= 0
            && request.resource.data.csvText is string
            && request.resource.data.csvText.size() < 200000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /operationalAuditEvents/{eventId} {
          allow read: if canReadOperationalAudit(organizationId, farmId);
          allow create: if hasFarmMembership(organizationId, farmId)
            && validOperationalAudit(
              request.resource.data, organizationId, farmId, eventId
            );
          allow update, delete: if false;
        }

        match /auditEvents/{auditEventId} {
          allow read: if canReadFarm(organizationId, farmId)
            && (
              isOrganizationOwner(organizationId)
              || hasFarmRole(organizationId, farmId, ['FARM_MANAGER', 'AUDITOR'])
            );
          allow create: if isOrganizationOwner(organizationId)
            && (
              (
                exists(farmPath(organizationId, farmId))
                && farmStatus(organizationId, farmId) == 'ACTIVE'
                && validAuditEvent(
                  request.resource.data,
                  organizationId,
                  farmId,
                  auditEventId
                )
              ) || validFarmAuditEvent(
                request.resource.data,
                organizationId,
                farmId,
                auditEventId
              )
            );
          allow update, delete: if false;
        }

      }
    }

    match /durian-smartfarm/root {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create: if signedInWithPhone()
        && !exists(dataRootPath())
        && request.resource.data.keys().hasAll([
          'projectId', 'documentName', 'schemaVersion', 'layout',
          'menuCategories', 'seedOwnerUid', 'classification', 'exampleData',
          'updatedAt'
        ])
        && request.resource.data.projectId == 'durian-smartfarm'
        && request.resource.data.documentName == 'root'
        && request.resource.data.seedOwnerUid == request.auth.uid
        && request.resource.data.classification == 'SIMULATED/TEST ONLY'
        && request.resource.data.exampleData == true
        && request.resource.data.updatedAt == request.time;
      allow update: if isSeedOperator()
        && request.resource.data.projectId == 'durian-smartfarm'
        && request.resource.data.documentName == 'root'
        && request.resource.data.seedOwnerUid == resource.data.seedOwnerUid
        && request.resource.data.classification == 'SIMULATED/TEST ONLY'
        && request.resource.data.exampleData == true
        && request.resource.data.updatedAt == request.time;
    }

    match /durian-smartfarm/root/{seedDocument=**} {
      allow create, update: if request.resource.data.keys().hasAll(['seedBatchId'])
        && request.resource.data.seedBatchId == 'KDOMS-PRODUCTION-MOCK-V1'
        && isSeedOperator()
        && request.resource.data.exampleData == true;
    }
  }
}
